{
  "name": "mathe-unterrichts-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kurze interaktive Aha-Momente für den Mathematikunterricht",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "node --test",
    "test:pages": "node scripts/verify-pages.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:visual": "node scripts/render-inequality-states.mjs",
    "test:area-visual": "node scripts/render-area-states.mjs",
    "test:circumcircle-visual": "node scripts/render-circumcircle-states.mjs",
    "test:incircle-visual": "node scripts/render-incircle-states.mjs",
    "test:unique-visual": "node scripts/render-unique-triangle-states.mjs",
    "test:number-line-visual": "node scripts/render-number-line-states.mjs",
    "test:order-visual": "node scripts/render-order-number-line-states.mjs",
    "test:absolute-visual": "node scripts/render-absolute-value-states.mjs",
    "test:addition-visual": "node scripts/render-addition-negative-states.mjs",
    "test:subtraction-visual": "node scripts/render-subtraction-negative-states.mjs",
    "test:multiplication-visual": "node scripts/render-multiplication-negative-states.mjs",
    "test:terms-visual": "node scripts/render-terms-variables-states.mjs",
    "test:like-terms-visual": "node scripts/render-like-terms-states.mjs",
    "test:term-multiplication-visual": "node scripts/render-term-multiplication-states.mjs",
